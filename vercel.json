{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/guide.html",
      "destination": "/guide.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
